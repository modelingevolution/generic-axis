@page "/registers"
@inherits LiveComponentBase
@inject SimulatorHost Host

<PageTitle>Registers &middot; Generic Axis</PageTitle>

@{
    var s = Host.Snapshot();
    var o = Host.Options;
}

<h1 class="mud-typography mud-typography-h5 mb-1">Registers</h1>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    The words a client reads from the simulator, unit @o.UnitId, per <code>docs/protocol.md</code> map v1.
    32-bit values decoded low word first@(s.Faults.SwappedWordOrder ? " (the simulator is injecting SwappedWordOrder, so they decode wrong on purpose)" : "").
</MudText>

<MudGrid>
    <MudItem xs="12" lg="6">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Command block (driver → PLC)</MudText>
        <RegisterTable Rows="@CommandRows(s, o.CommandBase)"/>
    </MudItem>
    <MudItem xs="12" lg="6">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Status block (PLC → driver)</MudText>
        <RegisterTable Rows="@StatusRows(s, o.StatusBase)"/>
    </MudItem>
</MudGrid>

@code {
    private static RegisterRow Row(int baseAddress, int offset, string prefix, string name, IReadOnlyList<ushort> block, string decoded) =>
        new($"{baseAddress + offset} ({prefix}+{offset})", name, $"0x{block[offset]:X4}", decoded);

    private static RegisterRow Row32(int baseAddress, int offset, string prefix, string name, IReadOnlyList<ushort> block, string unit) =>
        new($"{baseAddress + offset}–{baseAddress + offset + 1} ({prefix}+{offset})", name,
            $"0x{block[offset]:X4} 0x{block[offset + 1]:X4}",
            $"{I32(block, offset)} ({(I32(block, offset) / SimRegisters.Scale).ToString("F3", CultureInfo.InvariantCulture)} {unit})");

    private static int I32(IReadOnlyList<ushort> b, int offset) => unchecked((int)(((uint)b[offset + 1] << 16) | b[offset]));

    private IReadOnlyList<RegisterRow> CommandRows(SimSnapshot s, int c)
    {
        var b = s.CommandBlock;
        var u = Host.Options.Unit;
        return
        [
            Row(c, 0, "C", "Command", b, ((SimCommandBits)b[0]).ToString()),
            Row(c, 1, "C", "CommandSeq", b, b[1].ToString()),
            Row32(c, 2, "C", "TargetPosition", b, u),
            Row32(c, 4, "C", "Velocity", b, u + "/s"),
            Row32(c, 6, "C", "Acceleration", b, u + "/s²"),
            Row(c, 8, "C", "Heartbeat", b, b[8].ToString()),
            Row(c, 9, "C", "LeaseOwner", b, b[9] == 0 ? "0 (unowned)" : b[9].ToString()),
            Row(c, 10, "C", "WatchdogFault", b, b[10] == 0 ? "0 healthy" : $"{b[10]} tripped"),
            Row(c, 11, "C", "WatchdogTrips", b, b[11].ToString()),
        ];
    }

    private IReadOnlyList<RegisterRow> StatusRows(SimSnapshot s, int st)
    {
        var b = s.StatusBlock;
        var u = Host.Options.Unit;
        return
        [
            Row(st, 0, "S", "State", b, $"{b[0]} {(SimAxisState)b[0]}"),
            Row(st, 1, "S", "Flags", b, ((SimStatusFlags)b[1]).ToString()),
            Row32(st, 2, "S", "ActualPosition", b, u),
            Row32(st, 4, "S", "ActualVelocity", b, u + "/s"),
            Row(st, 6, "S", "FaultCode", b, $"{b[6]} {(SimFaultCode)b[6]}"),
            Row(st, 7, "S", "CommandAck", b, b[7].ToString()),
            Row32(st, 8, "S", "TravelMin", b, u),
            Row32(st, 10, "S", "TravelMax", b, u),
            Row32(st, 12, "S", "MaxVelocity", b, u + "/s"),
            Row(st, 14, "S", "MapVersion", b, b[14].ToString()),
        ];
    }
}

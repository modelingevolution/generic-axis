@page "/registers"
@inherits LiveComponentBase
@implements IAsyncDisposable
@using ModelingEvolution.GenericAxis.TestApp.Registers
@inject SimulatorHost Host
@inject ILoggerFactory LoggerFactory

<PageTitle>Registers &middot; Generic Axis</PageTitle>

@{
    var o = Host.Options;
    var reader = _reader;
    var reading = reader?.Latest;
}

<h1 class="mud-typography mud-typography-h5 mb-1">Registers</h1>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Both blocks decoded by the same decoder as <code>--dump</code> (<code>docs/protocol.md</code> map v1, 32-bit values
    low word first). Read-only: no lease, no beat, no write.
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <div class="d-flex flex-wrap gap-2 align-center">
        <MudSelect T="bool" @bind-Value="_remote" Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:220px" data-testid="registers-source">
            <MudSelectItem Value="false">In-app simulator</MudSelectItem>
            <MudSelectItem Value="true">host:port / unit</MudSelectItem>
        </MudSelect>
        @if (_remote)
        {
            <MudTextField T="string" @bind-Value="_host" Label="Host" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:180px" data-testid="registers-host"/>
            <MudNumericField T="int" @bind-Value="_port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:110px" data-testid="registers-port"/>
            <MudNumericField T="int" @bind-Value="_unit" Label="Unit" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:90px"/>
            <MudNumericField T="int" @bind-Value="_commandBase" Label="Command base" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:130px"/>
            <MudNumericField T="int" @bind-Value="_statusBase" Label="Status base" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(reader is not null)" Style="max-width:130px"/>
            @if (reader is null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync" data-testid="registers-read">Read at 5 Hz</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" OnClick="StopAsync" data-testid="registers-stop">Stop reading</MudButton>
            }
        }
    </div>
    @if (_formError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_formError</MudAlert>
    }
</MudPaper>

@if (!_remote)
{
    var s = Host.Snapshot();
    <MudText Typo="Typo.body2" Class="mb-2">
        In-app simulator, unit @o.UnitId, C = holding @o.CommandBase, S = input @o.StatusBase@(s.Faults.SwappedWordOrder ? " — injecting SwappedWordOrder, so 32-bit values decode wrong on purpose" : "").
    </MudText>
    <RegisterBlocks Rows="@RegisterDump.Decode(new RegisterMap(o.CommandBase, o.StatusBase), s.CommandBlock.AsSpan(), s.StatusBlock.AsSpan())"/>
}
else if (reader is not null)
{
    <MudText Typo="Typo.body2" Class="mb-2" data-testid="registers-endpoint">
        @reader.Endpoint — @reader.Reads reads@(reading is null ? "" : $", last at {reading.At:HH:mm:ss.fff} UTC")
    </MudText>
    @if (reading?.Error is { } error)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" data-testid="registers-error">@error</MudAlert>
    }
    @if (reading is { Rows.Count: > 0 })
    {
        <RegisterBlocks Rows="@reading.Rows"/>
    }
}

@code {
    private bool _remote;
    private string _host = "127.0.0.1";
    private int _port = 502;
    private int _unit = 1;
    private int _commandBase = 0;
    private int _statusBase = 100;
    private string? _formError;
    private RemoteRegisterReader? _reader;

    protected override TimeSpan RefreshInterval => RemoteRegisterReader.Period;

    private async Task StartAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_host)) { _formError = "Host is required."; return; }
        if (_port is < 1 or > 65535) { _formError = $"Port {_port} is outside 1–65535."; return; }
        if (_unit is < 0 or > 255) { _formError = $"Unit {_unit} is outside 0–255."; return; }
        await StopAsync();
        _reader = new RemoteRegisterReader(new RegisterEndpoint(_host.Trim(), _port, (byte)_unit, _commandBase, _statusBase), LoggerFactory);
    }

    private async Task StopAsync()
    {
        var reader = _reader;
        _reader = null;
        if (reader is not null) await reader.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        await StopAsync();
    }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> because sources MERGE with the machine-level config, which lists
         nuget.modelingevolution.com — reachable from WSL but NOT from Windows or from a
         GitHub-hosted runner, so every restore that does not clear it waits out a connection
         timeout to a feed this repo does not need. Every package here (RocketWelder.SDK.* included)
         is published to nuget.org.

         One file at src/ rather than one per project: in rw2 this had to be scoped to the two
         plugin directories so it did not change restore for forty other projects. Here the repo IS
         the plugin, so the repo is the correct scope. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

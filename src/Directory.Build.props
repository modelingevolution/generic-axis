<Project>

  <!--
    Single source of version metadata for the repo.

    The three 1.0.0 values below are PLACEHOLDERS that the release workflow rewrites from the git
    tag (.github/workflows/publish-nuget.yml, "Inject version into csproj"). They are never bumped by
    hand and never committed at a real version — a version in a committed csproj is a version that
    disagrees with the tag the moment anyone forgets to change it.

    <Version> is the NuGet package version and keeps any prerelease suffix; AssemblyVersion and
    FileVersion must be numeric, so the workflow strips the suffix before injecting them.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/generic-axis</RepositoryUrl>
  </PropertyGroup>

</Project>
